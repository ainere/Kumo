{
  "name": "kumo",
  "version": "1.0.0",
  "description": "Cross-provider CLI orchestrator pairing frontier reasoning root models with cheap and efficient worker models.",
  "type": "module",
  "bin": {
    "kumo": "./bin/kumo.js",
    "orchestrator": "./bin/kumo.js"
  },
  "main": "./src/cli.js",
  "scripts": {
    "test": "node --test",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json",
    "check": "npm run lint && npm run typecheck && npm test",
    "refresh:codex-protocol": "node scripts/refresh-codex-protocol.mjs",
    "doctor": "node ./bin/kumo.js doctor"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "commander": "^13.1.0",
    "zod": "^4.6.7"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "private": true,
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.20.5",
    "eslint": "^9.39.5",
    "globals": "^15.15.0",
    "typescript": "^5.9.3"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
