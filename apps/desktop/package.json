{
  "name": "@kumo/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Kumo desktop app: the Electron shell over the Kumo engine (src/core).",
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:e2e": "electron-vite build && playwright test",
    "dist": "electron-vite build && node scripts/stage-engine.mjs && electron-builder --publish never"
  },
  "license": "GPL-3.0-or-later",
  "devDependencies": {
    "@codemirror/language": "^6.13.1",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@lezer/highlight": "^1.2.5",
    "@playwright/test": "^1.64.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "electron": "45.0.0",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "vite": "^8.3.5"
  },
  "dependencies": {
    "electron-updater": "^6.8.11"
  },
  "optionalDependencies": {
    "node-pty": "^1.1.0"
  }
}
